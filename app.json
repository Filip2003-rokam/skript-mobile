{
  "expo": {
    "name": "Skript",
    "slug": "skript",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "skript",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "NSCalendarsWriteOnlyAccessUsageDescription": "Skript dodaje sesije i sastanke u tvoj kalendar."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.skript.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F6F6F4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Skript koristi kameru da skenira QR kod eventa.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-dev-client",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F6F4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Skript koristi mikrofon da snimi glasovnu belešku posle razgovora.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "sr",
              "en"
            ],
            "android": [
              "sr",
              "en"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "41f96230-ad1b-4be6-b233-bd8227d2501e"
      }
    },
    "owner": "filip03",
    "locales": {
      "sr": "./languages/sr.json",
      "en": "./languages/en.json"
    }
  }
}
